{
  "info": { "name": "shipping api", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "version": "1.0.0", "description": "shipping company endpoints for admin" },
  "variable": [ { "key": "base_url", "value": "http://localhost:8080" }, { "key": "auth_token", "value": "" }, { "key": "client_id", "value": "" } ],
  "item": [
    { "name": "shipping", "item": [
      { "name": "create shipping company", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies", "host": ["{{base_url}}"], "path": ["admin","shipping-companies"] }, "body": { "mode": "raw", "raw": "{}" } } },
      { "name": "get by id", "request": { "method": "GET", "header": [ { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies/:id?query={}", "host": ["{{base_url}}"], "path": ["admin","shipping-companies",":id"], "query": [{"key":"query","value":"{}"}] } } },
      { "name": "list", "request": { "method": "GET", "header": [ { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies?page=1&perPage=10&query={}", "host": ["{{base_url}}"], "path": ["admin","shipping-companies"], "query": [{"key":"page","value":"1"},{"key":"perPage","value":"10"},{"key":"query","value":"{}"}] } } },
      { "name": "update by id", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies/:id", "host": ["{{base_url}}"], "path": ["admin","shipping-companies",":id"] }, "body": { "mode": "raw", "raw": "{}" } } },
      { "name": "delete by id", "request": { "method": "DELETE", "header": [ { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies/:id", "host": ["{{base_url}}"], "path": ["admin","shipping-companies",":id"] } } },
      { "name": "bulk delete", "request": { "method": "DELETE", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "x-access-token", "value": "{{auth_token}}" }, { "key": "x-client", "value": "{{client_id}}" } ], "url": { "raw": "{{base_url}}/admin/shipping-companies", "host": ["{{base_url}}"], "path": ["admin","shipping-companies"] }, "body": { "mode": "raw", "raw": "{\n  \"ids\": [\n    \"66a7a0a6d1f1a2b3c4d5e6f7\",\n    \"66a7a0a6d1f1a2b3c4d5e6f8\"\n  ]\n}" } } }
    ] }
  ]
}
